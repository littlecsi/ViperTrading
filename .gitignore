# Virtual environment
.viper

# API credentials
config.py

# Python
__pycache__/
*.pyc

# Journals: one directory per mode (futures/test/logs, futures/live/logs).
# The bare futures/logs/ is the pre-split location, kept so an existing
# working tree's old journal stays ignored rather than turning up untracked.
futures/logs/
futures/*/logs/

# Editor / OS
.vscode
.DS_Store

# Local scratch / test scripts
test.py

# Claude Code skill lockfile (machine-computed hashes)
skills-lock.json

# Misc
*.xlsx
*.png
*.pem

# Backtest kline/funding cache (re-downloadable, ~40MB)
backtest/data/

# Backtest raw output streams (regenerable by backtest/run.py, ~1.4GB).
# The small summaries beside them - metrics.json, summary.json, report.html -
# ARE tracked: they are what a reader needs to see a run's result without
# re-running it, and they stay small.
backtest/results/*.jsonl
